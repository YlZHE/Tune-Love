node_modules/
dist/
src-tauri/target/
src-tauri/vendor/*/target/
src-tauri/gen/
artifacts/
*.log

# Large third-party tool binaries and source archives (fetched locally, not redistributed here)
src-tauri/vendor/tools/
src-tauri/python/
src-tauri/vendor/**/*.zip
src-tauri/vendor/**/*.tar.gz
# Sidecar binaries produced by scripts/build-devocal-engine.mjs
src-tauri/binaries/
# VC++ runtime DLLs copied from Visual Studio by scripts/fetch-vcrt.ps1
src-tauri/vcrt/
devocal/target/
# Model weights, audio and caches never belong in the repo
*.onnx
*.pth
*.npy
*.wav
*.mp3
*.flac
# Generated StemgenRT reference fixtures (regenerate with devocal/engine/tools/stemgen_reference.py)
devocal/engine/tests/fixtures/*.f32
__pycache__/
.pytest_cache/
test-results/
playwright-report/
