{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tune Love",
  "version": "0.2.0",
  "identifier": "io.github.ylzhe.tunelove",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Tune Love",
      "width": 468, "height": 242, "resizable": false,
      "decorations": false, "transparent": true,
      "shadow": false, "alwaysOnTop": true, "center": true
    }, {
      "label": "settings", "title": "Tune Love · 设置", "url": "index.html?view=settings",
      "create": false, "visible": false, "focus": false,
      "width": 760, "height": 540, "minWidth": 520, "minHeight": 380,
      "resizable": true, "decorations": false, "shadow": true,
      "center": true, "backgroundColor": "#0d111c", "theme": "Dark"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "licenseFile": "../LICENSE"
  }
}
